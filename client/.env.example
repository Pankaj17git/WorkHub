# Database (MySQL/MariaDB via Prisma)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=workhub
DATABASE_URL=mysql://root:@127.0.0.1:3306/workhub

# Auth
JWT_SECRET=change_me_to_a_long_random_secret

# Email OTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WorkHub <no-reply@workhub.local>"

# Cloudinary (File and profile image uploads)
NEXT_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_CLOUD_API_KEY=your_cloudinary_api_key
NEXT_CLOUD_API_SECRET=your_cloudinary_api_secret

# Twilio / Fast2SMS (phone SMS OTP - optional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
