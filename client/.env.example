# Database (MySQL/MariaDB via Prisma)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=workhub
DATABASE_URL=mysql://root:@127.0.0.1:3306/workhub

# Auth
JWT_SECRET=change_me_to_a_long_random_secret

# Email OTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WorkHub <no-reply@workhub.local>"

# Supabase (file uploads only - optional)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=uploads

# Twilio / Fast2SMS (phone SMS OTP - not used yet)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
