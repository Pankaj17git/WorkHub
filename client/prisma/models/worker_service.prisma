enum PricingType {
  HOURLY
  FIXED
}

model WorkerService {
  id                 BigInt      @id @default(autoincrement())
  workerId           BigInt      @map("worker_id")
  worker             Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  serviceName        String      @map("service_name") @db.VarChar(100)
  price              Decimal     @db.Decimal(10, 2)
  pricingType        PricingType @default(HOURLY) @map("pricing_type")
  isActive           Boolean     @default(true) @map("is_active")
  emergencyAvailable Boolean     @default(false) @map("emergency_available")

  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([workerId, serviceName])
  @@index([serviceName])
  @@index([workerId])
  @@map("worker_services")
}
