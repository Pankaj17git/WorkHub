enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

model WorkerConnection {
  id                BigInt           @id @default(autoincrement())
  workerId          BigInt           @map("worker_id")
  worker            Worker           @relation("SentConnections", fields: [workerId], references: [id], onDelete: Cascade)
  connectedWorkerId BigInt           @map("connected_worker_id")
  connectedWorker   Worker           @relation("ReceivedConnections", fields: [connectedWorkerId], references: [id], onDelete: Cascade)
  status            ConnectionStatus @default(PENDING)

  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([workerId, connectedWorkerId])
  @@index([workerId])
  @@index([connectedWorkerId])
  @@map("worker_connections")
}
