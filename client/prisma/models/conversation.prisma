enum ConversationType {
  DIRECT
  JOB_GROUP
}

model Conversation {
  id                  BigInt               @id @default(autoincrement())
  type                ConversationType     @default(DIRECT)
  customerId          BigInt?              @map("customer_id")
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  workerId            BigInt?              @map("worker_id")
  worker              Worker?              @relation(fields: [workerId], references: [id], onDelete: SetNull)
  jobId               BigInt?              @map("job_id")
  job                 Job?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)
  directHireRequestId BigInt?              @map("direct_hire_request_id")
  directHireRequest   DirectHireRequest?   @relation(fields: [directHireRequestId], references: [id], onDelete: SetNull)
  assignmentId        BigInt?              @map("assignment_id")
  assignment          Assignment?          @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  members             ConversationMember[]
  messages            Message[]

  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([jobId])
  @@index([customerId])
  @@index([workerId])
  @@map("conversations")
}

model ConversationMember {
  id             BigInt       @id @default(autoincrement())
  conversationId BigInt       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         BigInt       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamp(6)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}
