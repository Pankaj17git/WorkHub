model Worker {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id])

  addressId       BigInt?   @unique @map("address_id")
  address         Address?  @relation(fields: [addressId], references: [id])

  headline       String?   @db.VarChar(255)
  bio            String?   @db.Text
  portfolio      String?   @db.VarChar(500)
  isVerified     Boolean   @default(false) @map("is_verified")
  hourlyRate     Decimal?  @map("hourly_rate") @db.Decimal(10, 2)

  skills                    Skill[]
  services                  WorkerService[]
  availabilities            WorkerAvailability[]
  availabilityExceptions    WorkerAvailabilityException[]
  applications              JobApplication[]
  assignments               Assignment[]
  directHireRequests        DirectHireRequest[]
  sentConnections           WorkerConnection[]            @relation("SentConnections")
  receivedConnections       WorkerConnection[]            @relation("ReceivedConnections")
  sentTeamInvitations       TeamInvitation[]              @relation("SentTeamInvitations")
  receivedTeamInvitations   TeamInvitation[]              @relation("ReceivedTeamInvitations")
  staffingRequests          StaffingRequest[]
  reviews                   Review[]
  conversations             Conversation[]

  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("workers")
}